{
	"$schema": "/usr/share/swaync/configSchema.json",
	"positionX": "left",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"cssPriority": "application",
	"control-center-margin-top": 4,
	"control-center-margin-bottom": 4,
	"control-center-margin-right": 0,
	"control-center-margin-left": 4,
	"notification-2fa-action": true,
	"notification-inline-replies": false,
	"fit-to-screen": true,
	"control-center-width": 360,
	"control-center-height": 600,
	"notification-window-width": 360,
	"keyboard-shortcuts": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"script-fail-notify": true,
	"widgets": [
		"title",
		"dnd",
		"buttons-grid#connectivity",
		"volume",
		"backlight",
		"mpris",
		"notifications",
		"buttons-grid#power"
	],
	"widget-config": {
		"title": {
			"text": "Notification Center",
			"clear-all-button": true,
			"button-text": "Clear All"
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"buttons-grid#connectivity": {
			"buttons-per-row": 3,
			"actions": [
				{
					"label": "󰂯",
					"type": "toggle",
					"active": false,
					"command": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
					"update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
				},
				{
					"label": "󰤨",
					"type": "toggle",
					"active": false,
					"command": "nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on",
					"update-command": "nmcli radio wifi | grep -q enabled && echo true || echo false"
				},
				{
					"label": "󰁫",
					"type": "toggle",
					"active": false,
					"command": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off; nmcli radio wifi | grep -q enabled && nmcli radio wifi off",
					"update-command": "bluetoothctl show | grep -q 'Powered: no' && nmcli radio wifi | grep -q disabled && echo true || echo false"
				}
			]
		},
		"buttons-grid#power": {
			"buttons-per-row": 4,
			"actions": [
				{
					"label": "󰌾",
					"type": "normal",
					"command": "loginctl lock-session"
				},
				{
					"label": "󰍃",
					"type": "normal",
					"command": "swaymsg exit"
				},
				{
					"label": "󰜉",
					"type": "normal",
					"command": "systemctl reboot"
				},
				{
					"label": "󰐥",
					"type": "normal",
					"command": "systemctl poweroff"
				}
			]
		},
		"volume": {
			"label": "",
			"show-per-app": false
		},
		"backlight": {
			"label": ""
		},
		"mpris": {
			"image-size": 64,
			"image-radius": 8
		}
	}
}
