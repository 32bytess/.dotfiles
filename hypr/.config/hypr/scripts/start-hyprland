#!/bin/sh
# Launch Hyprland with NVIDIA PRIME support
# AMD iGPU (card1) drives the built-in display; NVIDIA is card0

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_CURRENT_DESKTOP=Hyprland

# Use AMD iGPU (card1) first so Hyprland drives eDP-1 natively;
# NVIDIA (card0) is available for PRIME offload rendering
export AQ_DRM_DEVICES="/dev/dri/card1:/dev/dri/card0"

exec /usr/bin/start-hyprland "$@"
