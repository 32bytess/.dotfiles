#!/usr/bin/env python3
"""Dwindle-style autotiling for sway/i3.

Subscribes to focus events and sets the split direction (splitv/splith) of the
focused container based on whether it is taller or wider, so new windows always
split along the longer axis — mimicking Hyprland's dwindle layout.

Depends only on the system-wide i3ipc Python module.
"""
import i3ipc


def switch_splitting(i3, _event):
    try:
        con = i3.get_tree().find_focused()
    except Exception:
        return

    if con is None or con.type not in ("con", "floating_con"):
        return

    # Leave floating windows, fullscreen windows, and tabbed/stacked
    # containers alone — splitting them makes no sense.
    is_floating = con.floating is not None and con.floating.endswith("on")
    is_fullscreen = con.fullscreen_mode == 1
    parent_layout = con.parent.layout if con.parent else None
    is_tabbed_or_stacked = parent_layout in ("tabbed", "stacked")

    if is_floating or is_fullscreen or is_tabbed_or_stacked:
        return

    new_layout = "splitv" if con.rect.height > con.rect.width else "splith"
    if new_layout != con.layout:
        i3.command(new_layout)


def main():
    i3 = i3ipc.Connection()
    for event in ("window::focus", "window::move", "window::floating"):
        i3.on(event, switch_splitting)
    i3.main()


if __name__ == "__main__":
    main()
