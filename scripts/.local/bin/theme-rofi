#!/usr/bin/env bash
set -euo pipefail

# wallust may be a distro package (on PATH) or a `cargo install`.
WALLUST=$(command -v wallust || echo "$HOME/.cargo/bin/wallust")
if [ ! -x "$WALLUST" ]; then
	echo "theme-rofi: wallust not found" >&2
	exit 1
fi

CHOSEN=$(
	"$WALLUST" theme list 2>&1 |
		sed 's/\x1b\[[0-9;]*m//g' |
		grep -v "^Available" |
		grep -v "^$" |
		sed 's/^- //' |
		rofi -dmenu -p "Theme" -theme ~/.config/rofi/theme.rasi
) || exit 1

"$WALLUST" theme "$CHOSEN" && "$HOME/.local/bin/theme-reload"
