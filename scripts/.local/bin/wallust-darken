#!/usr/bin/env python3
"""
Post-process wallust colors: force a near-black background with a subtle
tint from the dominant accent color, and boost accent colors so they read
clearly on that dark surface.

Idempotent — running it twice produces the same output.
"""

import colorsys, json, os, subprocess, sys, tempfile

COLORS_FILE = os.path.expanduser("~/.cache/wallust/current.json")


def hex_to_rgb(h: str) -> tuple[float, float, float]:
    h = h.lstrip("#")
    return tuple(int(h[i : i + 2], 16) / 255.0 for i in (0, 2, 4))


def rgb_to_hex(r: float, g: float, b: float) -> str:
    return "#{:02X}{:02X}{:02X}".format(int(r * 255), int(g * 255), int(b * 255))


def hls(hex_color: str) -> tuple[float, float, float]:
    return colorsys.rgb_to_hls(*hex_to_rgb(hex_color))


def from_hls(h: float, l: float, s: float) -> str:
    return rgb_to_hex(*colorsys.hls_to_rgb(h, l, s))


def process(colors: dict) -> dict:
    # Pick primary = most saturated among color1-color6
    accents = ["color1", "color2", "color3", "color4", "color5", "color6"]
    primary_key = max(accents, key=lambda k: hls(colors[k])[2])
    ph, _, ps = hls(colors[primary_key])

    # Background: near-black with primary hue tint
    colors["background"] = from_hls(ph, 0.07, 0.20)
    # color0: darker surface variant (terminal black)
    colors["color0"] = from_hls(ph, 0.05, 0.15)
    # color8: comments / dim text — must be readable on dark bg
    colors["color8"] = from_hls(ph, 0.42, 0.12)

    # Foreground / bright whites: force light
    for k in ("foreground", "cursor", "color7", "color15"):
        if k not in colors:
            continue
        h, l, s = hls(colors[k])
        colors[k] = from_hls(h, max(l, 0.88), s)

    # Accent colors (normal + bright): boost lightness so they pop on dark bg
    for k in accents + [
        "color9",
        "color10",
        "color11",
        "color12",
        "color13",
        "color14",
    ]:
        h, l, s = hls(colors[k])
        new_l = max(l, 0.60)
        new_s = min(s * 1.15, 1.0)
        colors[k] = from_hls(h, new_l, new_s)

    return colors


def main() -> None:
    if not os.path.exists(COLORS_FILE):
        print(f"wallust-darken: {COLORS_FILE} not found, skipping", file=sys.stderr)
        sys.exit(0)

    with open(COLORS_FILE) as f:
        colors = json.load(f)

    colors = process(colors)

    with tempfile.NamedTemporaryFile(mode="w", suffix=".json", delete=False) as tmp:
        json.dump(colors, tmp, indent=2)
        tmp_path = tmp.name

    try:
        subprocess.run(
            [
                os.path.expanduser("~/.cargo/bin/wallust"),
                "cs",
                tmp_path,
                "-f",
                "wallust",
                "--no-hooks",
            ],
            check=True,
        )
    finally:
        os.unlink(tmp_path)


if __name__ == "__main__":
    main()
