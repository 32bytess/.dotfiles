#!/usr/bin/env bash
set -euo pipefail

FULL_PATH=$(realpath "$1")

# wallust may be a distro package (on PATH) or a `cargo install`.
WALLUST=$(command -v wallust || echo "$HOME/.cargo/bin/wallust")
if [ ! -x "$WALLUST" ]; then
	echo "wallpaper-picker: wallust not found" >&2
	exit 1
fi

# Set the wallpaper immediately
pkill swaybg || true
swaybg -i "$FULL_PATH" -m fill &

# Regenerate the color palette from the wallpaper, then reload everything
"$WALLUST" run "$FULL_PATH" && {
	sleep 0.5

	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
		hyprctl reload
	elif [ -n "${SWAYSOCK:-}" ]; then
		swaymsg reload
	fi

	pkill -SIGUSR2 waybar 2>/dev/null || true
	swaync-client --reload-css 2>/dev/null || true
	pkill -SIGUSR1 kitty 2>/dev/null || true
	tmux source-file ~/.config/tmux/theme.conf 2>/dev/null || true
	pkill -SIGUSR1 nvim 2>/dev/null || true

	# Qt/KDE and GTK apps (LibreOffice, Dolphin, pavucontrol, ...) are left on a
	# fixed system theme and intentionally not re-themed from the wallust palette.
}

# Remember the wallpaper so it is restored on next login. Must honour
# XDG_STATE_HOME: the autostart entries that read this file back do.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$STATE_DIR"
echo "$FULL_PATH" >"$STATE_DIR/current-wall"
