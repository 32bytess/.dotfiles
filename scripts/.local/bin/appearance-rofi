#!/usr/bin/env bash
set -euo pipefail

WAYBAR_CONF_DIR="$HOME/.config/waybar"

CHOSEN=$(printf 'Modern\nMinimal' \
    | rofi -dmenu -p "Appearance" -theme ~/.config/rofi/theme.rasi) || exit 1

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    # ── Hyprland ─────────────────────────────────────────────────────────
    THEMES_DIR="$HOME/.config/hypr/themes"
    CONF_DIR="$HOME/.config/hypr/conf"
    case "$CHOSEN" in
        Modern)
            ln -sf "$THEMES_DIR/modern.lua"     "$CONF_DIR/appearance.lua"
            hyprctl keyword general:gaps_in  4
            hyprctl keyword general:gaps_out 2
            ;;
        Minimal)
            ln -sf "$THEMES_DIR/minimal.lua"    "$CONF_DIR/appearance.lua"
            hyprctl keyword general:gaps_in  0
            hyprctl keyword general:gaps_out 0
            ;;
    esac
    hyprctl reload

elif [ -n "${SWAYSOCK:-}" ]; then
    # ── Sway ─────────────────────────────────────────────────────────────
    THEMES_DIR="$HOME/.config/sway/themes"
    CONF_DIR="$HOME/.config/sway/config.d"
    case "$CHOSEN" in
        Modern)
            ln -sf "$THEMES_DIR/appearance_modern.conf" "$CONF_DIR/appearance.conf"
            ln -sf sway/modern/config.jsonc             "$WAYBAR_CONF_DIR/config.jsonc"
            ln -sf sway/modern/style.css                "$WAYBAR_CONF_DIR/style.css"
            swaymsg "gaps inner all set 4; gaps outer all set 2"
            ;;
        Minimal)
            ln -sf "$THEMES_DIR/appearance_minimal.conf" "$CONF_DIR/appearance.conf"
            ln -sf sway/minimal/config.jsonc             "$WAYBAR_CONF_DIR/config.jsonc"
            ln -sf sway/minimal/style.css                "$WAYBAR_CONF_DIR/style.css"
            swaymsg "gaps inner all set 0; gaps outer all set 0"
            ;;
    esac
    swaymsg reload


else
    echo "appearance-rofi: unknown compositor" >&2
    exit 1
fi

pkill -SIGUSR2 waybar || true
