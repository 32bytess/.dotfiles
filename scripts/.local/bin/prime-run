#!/bin/sh
# Run a command on the discrete NVIDIA GPU via PRIME render offload.
#
# With no NVIDIA GPU present these variables are meaningless and can confuse
# Mesa, so degrade to a plain exec instead. That keeps prime-menu -- and its
# keybinding -- working on every machine rather than only on an Optimus laptop.

for vendor in /sys/class/drm/card*/device/vendor; do
	[ -r "$vendor" ] || continue
	if [ "$(cat "$vendor")" = "0x10de" ]; then
		__NV_PRIME_RENDER_OFFLOAD=1 \
			__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0 \
			__GLX_VENDOR_LIBRARY_NAME=nvidia \
			__VK_LAYER_NV_optimus=NVIDIA_only \
			exec "$@"
	fi
done

exec "$@"
