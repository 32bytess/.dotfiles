#!/usr/bin/env bash
pgrep -x wofi >/dev/null && {
  pkill wofi
  exit 0
}

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"

chosen=$(find "$THEMES_DIR" -maxdepth 1 -type f ! -name 'current.*' \
  -exec basename {} \; | sort |
  wofi --dmenu --prompt "Theme")

[[ -z "$chosen" ]] && exit 0

"${HOME}/.local/bin/set-theme" "$chosen"
