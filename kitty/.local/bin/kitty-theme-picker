#!/usr/bin/env bash
# Pick a kitty theme via wofi and apply it live

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes"
CURRENT="$THEMES_DIR/current.conf"

chosen=$(find "$THEMES_DIR" -maxdepth 1 -name '*.conf' ! -name 'current.conf' \
  -exec basename {} .conf \; | sort \
  | wofi --dmenu --prompt "Kitty theme" --width 300 --height 200)

[[ -z "$chosen" ]] && exit 0

ln -sf "$THEMES_DIR/$chosen.conf" "$CURRENT"
pkill -SIGUSR1 kitty 2>/dev/null || true
