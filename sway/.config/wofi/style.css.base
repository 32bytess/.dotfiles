* {
    font-family: "Fira Code", monospace;
    font-size: 13px;
    border: none;
    border-radius: 0;
}

window {
    background: #000000;
    border: 1px solid @rose;
    border-radius: 12px;
}

#input {
    background: #000000;
    border: 1px solid @overlay;
    border-radius: 8px;
    color: @text;
    padding: 8px 12px;
    margin: 10px;
}

#input:focus {
    border-color: @rose;
}

#scroll {
    margin: 0 8px 8px 8px;
}

#entry {
    padding: 6px 12px;
    border-radius: 6px;
    color: @muted;
    background: transparent;
}

#entry:selected {
    background: @overlay;
    color: @text;
}

#entry:selected #text {
    color: @text;
}

#text {
    color: @subtle;
}
