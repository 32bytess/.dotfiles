# Default config for sway
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu wofi --show drun
set $wallpaper ~/dotfiles/wallpapers/moon-landscape.jpg
set $wallpaper2 ~/dotfiles/wallpapers/portrait-halloween-scene-illustration-anime-style.jpg
set $opacity 0.92

include config.d/*
include /etc/sway/config.d/
