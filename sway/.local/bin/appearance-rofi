#!/usr/bin/env bash
set -euo pipefail

# Define paths
SWAY_THEMES_DIR="$HOME/.config/sway/themes"
SWAY_CONF_DIR="$HOME/.config/sway/config.d"
WAYBAR_CONF_DIR="$HOME/.config/waybar"

# Options for Rofi
OPTIONS="Modern\nMinimal"

CHOSEN=$(echo -e "$OPTIONS" | rofi -dmenu -p "Appearance" -theme ~/.config/rofi/theme.rasi) || exit 1

case "$CHOSEN" in
    Modern)
        ln -sf "$SWAY_THEMES_DIR/appearance_modern.conf" "$SWAY_CONF_DIR/appearance.conf"
        ln -sf style_modern.css "$WAYBAR_CONF_DIR/style.css"
        ln -sf config_modern.jsonc "$WAYBAR_CONF_DIR/config.jsonc"
        
        # Apply to existing windows instantly
        swaymsg "gaps inner all set 4; gaps outer all set 2"
        ;;
    Minimal)
        ln -sf "$SWAY_THEMES_DIR/appearance_minimal.conf" "$SWAY_CONF_DIR/appearance.conf"
        ln -sf style_minimal.css "$WAYBAR_CONF_DIR/style.css"
        ln -sf config_minimal.jsonc "$WAYBAR_CONF_DIR/config.jsonc"
        
        # Apply to existing windows instantly
        swaymsg "gaps inner all set 0; gaps outer all set 0"
        ;;
    *)
        exit 1
        ;;
esac

# Reload Sway
swaymsg reload

# Force Waybar to reload its styling
# SIGUSR2 tells waybar to reload the CSS file
pkill -SIGUSR2 waybar || true
