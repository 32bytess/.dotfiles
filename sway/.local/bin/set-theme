#!/usr/bin/env bash
# Usage: set-theme [<name>]   — no args lists available themes

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway/themes"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/sway-theme"

list_themes() {
  current="$(cat "$STATE_FILE" 2>/dev/null)"
  echo "Available themes:"
  for f in "$THEMES_DIR"/*; do
    name="$(basename "$f")"
    [[ "$name" == "$current" ]] && echo "  * $name  (active)" || echo "    $name"
  done
}

if [[ -z "$1" ]]; then
  list_themes
  exit 0
fi

THEME_FILE="$THEMES_DIR/$1"
if [[ ! -f "$THEME_FILE" ]]; then
  echo "Theme '$1' not found."
  list_themes
  exit 1
fi

# shellcheck source=/dev/null
source "$THEME_FILE"

COLORS_CSS="/* $1 */
@define-color base    $BASE;
@define-color surface $SURFACE;
@define-color overlay $OVERLAY;
@define-color muted   $MUTED;
@define-color subtle  $SUBTLE;
@define-color text    $TEXT;
@define-color love    $RED;
@define-color gold    $GOLD;
@define-color rose    $ACCENT;
@define-color foam    $CYAN;"

# --- Sway window colors ---
swaymsg "client.focused          $ACCENT  $BASE $TEXT $ACCENT  $ACCENT"
swaymsg "client.unfocused        $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY"
swaymsg "client.focused_inactive $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY"
swaymsg "client.urgent           $RED     $BASE $RED   $RED     $RED"

# --- Waybar ---
echo "$COLORS_CSS" >"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/colors.css"
if pkill -SIGUSR2 waybar 2>/dev/null; then
  sleep 0.2 && pkill -SIGUSR1 waybar 2>/dev/null # reload config, keep visibility state
fi

# --- Swaync ---
echo "$COLORS_CSS" >"${XDG_CONFIG_HOME:-$HOME/.config}/swaync/colors.css"
swaync-client --reload-css 2>/dev/null || true

# --- Wofi ---
WOFI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wofi"
{
  printf '%s\n\n' "$COLORS_CSS"
  cat "$WOFI_DIR/style.css.base"
} >"$WOFI_DIR/style.css"

# --- Kitty ---
KITTY_THEMES="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes"
if [[ -f "$KITTY_THEMES/$1.conf" ]]; then
  ln -sf "$KITTY_THEMES/$1.conf" "$KITTY_THEMES/current.conf"
  pkill -SIGUSR1 kitty 2>/dev/null || true
fi

# --- Persist ---
mkdir -p "$(dirname "$STATE_FILE")"
echo "$1" >"$STATE_FILE"
echo "Theme set to: $1"
