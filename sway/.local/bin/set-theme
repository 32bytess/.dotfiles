#!/usr/bin/env bash
set -euo pipefail
# Usage: set-theme [<name>]   — no args lists available themes

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/current-theme"

list_themes() {
  current="$(cat "$STATE_FILE" 2>/dev/null)"
  echo "Available themes:"
  for f in "$THEMES_DIR"/*; do
    name="$(basename "$f")"
    [[ "$name" == current.* ]] && continue
    [[ "$name" == "$current" ]] && echo "  * $name  (active)" || echo "    $name"
  done
}

if [[ -z "${1:-}" ]]; then
  list_themes
  exit 0
fi

THEME_FILE="$THEMES_DIR/$1"
if [[ ! -f "$THEME_FILE" ]]; then
  echo "Theme '$1' not found."
  list_themes
  exit 1
fi

# shellcheck source=/dev/null
source "$THEME_FILE"

COLORS_CSS="/* $1 */
@define-color base    $BASE;
@define-color surface $SURFACE;
@define-color overlay $OVERLAY;
@define-color muted   $MUTED;
@define-color subtle  $SUBTLE;
@define-color text    $TEXT;
@define-color love    $RED;
@define-color gold    $GOLD;
@define-color rose    $ACCENT;
@define-color foam    $CYAN;"

SWAY_COLORS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/theme-colors.conf"
cat >"$SWAY_COLORS_CONF" <<EOF
client.focused          $ACCENT  $BASE $TEXT $ACCENT  $ACCENT
client.unfocused        $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY
client.focused_inactive $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY
client.urgent           $RED     $BASE $RED   $RED     $RED
EOF

swaymsg "client.focused          $ACCENT  $BASE $TEXT $ACCENT  $ACCENT"
swaymsg "client.unfocused        $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY"
swaymsg "client.focused_inactive $OVERLAY $BASE $MUTED $OVERLAY $OVERLAY"
swaymsg "client.urgent           $RED     $BASE $RED   $RED     $RED"

# --- Waybar ---
echo "$COLORS_CSS" >"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/colors.css"
pkill -SIGUSR2 waybar 2>/dev/null || true

# --- Swaync ---
echo "$COLORS_CSS" >"${XDG_CONFIG_HOME:-$HOME/.config}/swaync/colors.css"
swaync-client --reload-css 2>/dev/null || true

# --- Wofi ---
WOFI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wofi"
{
  printf '%s\n\n' "$COLORS_CSS"
  cat "$WOFI_DIR/style.css.base"
} >"$WOFI_DIR/style.css"

# --- Kitty ---
cat >"$THEMES_DIR/current.kitty.conf" <<EOF
foreground              $TEXT
background              #000000
cursor                  $ACCENT
cursor_text_color       $BASE
selection_foreground    $BASE
selection_background    $ACCENT
url_color               $CYAN
active_border_color     $ACCENT
inactive_border_color   $OVERLAY
active_tab_foreground   $BASE
active_tab_background   $ACCENT
inactive_tab_foreground $MUTED
inactive_tab_background $SURFACE
tab_bar_background      $BASE
color0  $COLOR0
color1  $COLOR1
color2  $COLOR2
color3  $COLOR3
color4  $COLOR4
color5  $COLOR5
color6  $COLOR6
color7  $COLOR7
color8  $COLOR8
color9  $COLOR9
color10 $COLOR10
color11 $COLOR11
color12 $COLOR12
color13 $COLOR13
color14 $COLOR14
color15 $COLOR15
EOF
pkill -SIGUSR1 kitty 2>/dev/null || true

# --- Tmux ---
cat >"$THEMES_DIR/current.tmux.conf" <<EOF
set -g status-style "fg=$TEXT"
set -g status-right "#[fg=$ACCENT,bold] %d %B %y - %H:%M "
set -g window-status-format "#{?#{==:#{session_windows},1},, #[fg=$MUTED,nobold]#I.#W }"
set -g window-status-current-format "#{?#{==:#{session_windows},1},, #[fg=$ACCENT,bold]*.#W }"
set -g pane-border-style "fg=$SURFACE"
set -g pane-active-border-style "fg=$COLOR5"
EOF
tmux source-file "$THEMES_DIR/current.tmux.conf" 2>/dev/null || true

# --- Neovim ---
echo "${NVIM_THEME:-$1}" >"$THEMES_DIR/current.nvim"
# notify running nvim instances
for sock in /run/user/"$(id -u)"/nvim.*.0 "${TMPDIR:-/tmp}"/nvim*/0; do
  [[ -S "$sock" ]] && nvim --server "$sock" --remote-send \
    "<cmd>colorscheme ${NVIM_THEME:-$1}<cr>" 2>/dev/null || true
done

# --- Yazi ---
cat >"${XDG_CONFIG_HOME:-$HOME/.config}/yazi/theme.toml" <<EOF
[manager]
cwd             = { fg = "$ACCENT" }
hovered         = { fg = "$BASE", bg = "$ACCENT" }
preview_hovered = { underline = true }

find_keyword  = { fg = "$GOLD", bold = true, italic = true, underline = true }
find_position = { fg = "$COLOR5", bg = "reset", bold = true, italic = true }

marker_copied   = { fg = "$COLOR2", bg = "$COLOR2" }
marker_cut      = { fg = "$RED", bg = "$RED" }
marker_marked   = { fg = "$COLOR5", bg = "$COLOR5" }
marker_selected = { fg = "$ACCENT", bg = "$ACCENT" }

tab_active   = { fg = "$BASE", bg = "$ACCENT" }
tab_inactive = { fg = "$TEXT", bg = "$OVERLAY" }
tab_width    = 1

count_copied   = { fg = "$BASE", bg = "$COLOR2" }
count_cut      = { fg = "$BASE", bg = "$RED" }
count_selected = { fg = "$BASE", bg = "$ACCENT" }

border_symbol = "│"
border_style  = { fg = "$COLOR8" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "$OVERLAY", bg = "$OVERLAY" }

mode_normal = { fg = "$BASE", bg = "$ACCENT", bold = true }
mode_select = { fg = "$BASE", bg = "$COLOR2", bold = true }
mode_unset  = { fg = "$BASE", bg = "$RED",    bold = true }

progress_label  = { bold = true }
progress_normal = { fg = "$ACCENT", bg = "$OVERLAY" }
progress_error  = { fg = "$RED",    bg = "$OVERLAY" }

perm_type  = { fg = "$ACCENT" }
perm_read  = { fg = "$GOLD" }
perm_write = { fg = "$RED" }
perm_exec  = { fg = "$COLOR2" }
perm_sep   = { fg = "$COLOR8" }

[input]
border   = { fg = "$ACCENT" }
title    = {}
value    = {}
selected = { reversed = true }

[completion]
border   = { fg = "$ACCENT" }
active   = { bg = "$OVERLAY" }
inactive = {}

[tasks]
border  = { fg = "$ACCENT" }
title   = {}
hovered = { underline = true }

[which]
mask            = { bg = "$SURFACE" }
cand            = { fg = "$CYAN" }
rest            = { fg = "$SUBTLE" }
desc            = { fg = "$COLOR5" }
separator       = "  "
separator_style = { fg = "$COLOR8" }

[help]
on      = { fg = "$COLOR5" }
run     = { fg = "$COLOR5" }
desc    = { fg = "$SUBTLE" }
hovered = { bg = "$OVERLAY", bold = true }
footer  = { fg = "$OVERLAY", bg = "$TEXT" }

[filetype]
rules = [
  { mime = "image/*",                     fg = "$CYAN" },
  { mime = "video/*",                     fg = "$COLOR5" },
  { mime = "audio/*",                     fg = "$GOLD" },
  { mime = "application/zip",             fg = "$RED" },
  { mime = "application/gzip",            fg = "$RED" },
  { mime = "application/x-tar",           fg = "$RED" },
  { mime = "application/x-bzip2",         fg = "$RED" },
  { mime = "application/x-7z-compressed", fg = "$RED" },
  { mime = "application/x-rar",           fg = "$RED" },
  { name = "*",                           fg = "$TEXT" },
  { name = "*/",                          fg = "$ACCENT" },
]
EOF

# --- Persist ---
mkdir -p "$(dirname "$STATE_FILE")"
echo "$1" >"$STATE_FILE"
echo "Theme set to: $1"
