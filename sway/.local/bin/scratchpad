#!/bin/sh
# Usage: scratchpad <app_id> <launch_command...>
app_id="$1"
shift

tree=$(swaymsg -t get_tree)

is_visible=$(echo "$tree" | jq -e '.. | objects | select(.app_id? == "'"$app_id"'") | select(.visible == true) | .id' 2>/dev/null)
exists=$(echo "$tree" | jq -e '.. | objects | select(.app_id? == "'"$app_id"'") | .id' 2>/dev/null)

if [ -n "$is_visible" ]; then
    # Visible — exit fullscreen then hide
    swaymsg "[app_id=\"$app_id\"] fullscreen disable"
    swaymsg "[app_id=\"$app_id\"] move scratchpad"
elif [ -n "$exists" ]; then
    # In scratchpad — show and fullscreen
    swaymsg "[app_id=\"$app_id\"] scratchpad show"
    swaymsg "[app_id=\"$app_id\"] fullscreen enable"
else
    # Doesn't exist — launch (for_window will move it to scratchpad)
    "$@" &
fi
