#!/usr/bin/env bash
set -euo pipefail

CHOSEN=$(
	~/.cargo/bin/wallust theme list 2>&1 |
		sed 's/\x1b\[[0-9;]*m//g' |
		grep -v "^Available" |
		grep -v "^$" |
		sed 's/^- //' |
		rofi -dmenu -p "Theme" -theme ~/.config/rofi/theme.rasi
) || exit 1

~/.cargo/bin/wallust theme "$CHOSEN" &&
	# ~/.local/bin/wallust-darken &&
	{
		sleep 0.5
		swaymsg reload
		pkill -SIGUSR2 waybar || true
		swaync-client --reload-css 2>/dev/null || true
		pkill -SIGUSR1 kitty 2>/dev/null || true
		tmux source-file ~/.config/tmux/theme.conf 2>/dev/null || true
		pkill -SIGUSR1 nvim 2>/dev/null || true
	}
