#!/usr/bin/env bash
set -euo pipefail

FULL_PATH="$1"

swww img "$FULL_PATH" --transition-type grow --transition-pos 0.5,0.5 -o eDP-1
swww img "$FULL_PATH" --transition-type grow --transition-pos 0.5,0.5 -o HDMI-A-1

~/.cargo/bin/wallust run "$FULL_PATH" && {
	swaymsg reload
	pkill -SIGUSR2 waybar 2>/dev/null || true
	swaync-client --reload-css 2>/dev/null || true
	pkill -SIGUSR1 kitty 2>/dev/null || true
	tmux source-file ~/.config/tmux/theme.conf 2>/dev/null || true
	pkill -SIGUSR1 nvim 2>/dev/null || true
}

mkdir -p "$HOME/.local/state"
echo "$FULL_PATH" >"$HOME/.local/state/current-wall"
