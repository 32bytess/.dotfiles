#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="$HOME/dotfiles/wallpapers"
CHOSEN=$(ls "$WALL_DIR" | wofi --show dmenu --prompt "Select Wallpaper") || exit 1
FULL_PATH="$WALL_DIR/$CHOSEN"

swww img "$FULL_PATH" --transition-type grow --transition-pos 0.5,0.5

~/.cargo/bin/wallust run "$FULL_PATH" && {
	swaymsg reload
	pkill -SIGUSR2 waybar 2>/dev/null || true
	swaync-client --reload-css 2>/dev/null || true
}

mkdir -p "$HOME/.local/state"
echo "$FULL_PATH" >"$HOME/.local/state/current-wall"
