#!/bin/sh
tree=$(swaymsg -t get_tree)

# Check if the focused window is a scratchpad window
focused_is_scratch=$(echo "$tree" | jq -e '
  .. | objects | select(.focused? == true) | select(.scratchpad_state? != null) | select(.scratchpad_state != "none") | .id
' 2>/dev/null)

if [ -n "$focused_is_scratch" ]; then
    swaymsg 'fullscreen disable'
    swaymsg 'move scratchpad'
else
    swaymsg 'scratchpad show' && swaymsg 'fullscreen enable'
fi
