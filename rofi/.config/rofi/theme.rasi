@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    15px;
    padding:          8px;
    width:            480px;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          8px;
    padding:          8px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    15px;
    padding:          8px 12px;
    children:         [prompt, entry];
    spacing:          0;
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          2px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    border-radius:    15px;
    padding:          8px 12px;
    spacing:          8px;
    orientation:      horizontal;
}

element selected {
    background-color: @accent;
    text-color:       @fg;
}

element-icon {
    size:           24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
